{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "enum": [
            "root_not_readable",
            "invalid_plan_id",
            "plan_not_found",
            "storage_failed"
          ],
          "type": "string"
        },
        {
          "const": "confirmation_required",
          "description": "Acting needs `--yes` when no one is there to confirm.",
          "type": "string"
        },
        {
          "const": "apply_stopped",
          "description": "The run stopped partway. Check `gigsift history` for what happened.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Replaces the envelope when a command cannot produce a result at all.",
  "properties": {
    "command": {
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorBody"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "command",
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
